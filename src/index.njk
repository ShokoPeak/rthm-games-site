---
layout: base.njk
title: Home
---

<div class="hero">
  <h1>RTHM Games</h1>
  <p>Rhythm not guaranteed</p>
</div>

<h2 style="margin-bottom: 1rem;">What's new?</h2>

{% for post in collections.posts %}{% if loop.index <= 5 %}
<article class="post">
  <div class="post-date">{{ post.date | dateFormat }}{% if post.data.game %} &middot; <a href="/games/{{ post.data.game | slugify }}/" style="color: var(--accent-light);">{{ post.data.game }}</a>{% endif %}</div>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <div class="post-content">
    {{ post.templateContent | safe | truncate(300) }}
  </div>
</article>
{% endif %}{% endfor %}

{% if collections.posts.length > 5 %}
<p><a href="/updates/" style="color: var(--accent-light);">View all updates &rarr;</a></p>
{% endif %}
