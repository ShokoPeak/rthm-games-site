---
layout: base.njk
title: Heartbeat
---

<h1 style="margin-bottom: 0.5rem;">Heartbeat</h1>
<p style="color: var(--text-muted); margin-bottom: 2rem;">Automated technical updates on Margin Call development, generated by WorkBOT. Subject to being wrong.</p>

{% for post in collections.heartbeat %}
<article class="post heartbeat-post">
  <div class="post-date">{{ post.date | dateFormat }} &middot; <span class="workbot-tag">WorkBOT</span></div>
  <h2>{{ post.data.title }}</h2>
  <div class="post-content">
    {{ post.templateContent | safe }}
  </div>
</article>
{% endfor %}

{% if collections.heartbeat.length == 0 %}
<p style="color: var(--text-muted);">No heartbeats yet. Check back soon!</p>
{% endif %}
