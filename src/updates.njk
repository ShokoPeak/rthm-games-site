---
layout: base.njk
title: Updates
---

<h1 style="margin-bottom: 1.5rem;">All Updates</h1>

{% for post in collections.posts %}
<article class="post">
  <div class="post-date">{{ post.date | dateFormat }}{% if post.data.game %} &middot; <a href="/games/{{ post.data.game | slugify }}/" style="color: var(--accent-light);">{{ post.data.game }}</a>{% endif %}</div>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <div class="post-content">
    {{ post.templateContent | safe }}
  </div>
</article>
{% endfor %}

{% if collections.posts.length == 0 %}
<p style="color: var(--text-muted);">No updates yet. Check back soon!</p>
{% endif %}
