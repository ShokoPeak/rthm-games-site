---
pagination:
  data: collections.games
  size: 1
  alias: gameName
permalink: /games/{{ gameName | slugify }}/
layout: base.njk
eleventyComputed:
  title: "{{ gameName }}"
---

<h1 style="margin-bottom: 1.5rem;">{{ gameName }}</h1>

{% set posts = collections.games[gameName] %}
{% for post in posts %}
<article class="post">
  <div class="post-date">{{ post.date | dateFormat }}</div>
  <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
  <div class="post-content">
    {{ post.templateContent | safe }}
  </div>
</article>
{% endfor %}
